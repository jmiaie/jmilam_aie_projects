# Gemini API key, read ONLY by the server-side function in api/gemini.ts.
# - Local dev: copy to .env.local (git-ignored) and run `npm run dev`.
# - Vercel: set GEMINI_API_KEY under Project Settings -> Environment Variables.
# Never prefix it with VITE_ and never reference it from client code: anything
# the client bundle can see ships to every visitor.
GEMINI_API_KEY=your-gemini-api-key-here
